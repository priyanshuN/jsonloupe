{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.priyanshuN/jsonloupe",
  "title": "jsonloupe",
  "description": "Open huge JSON locally and give agents its shape, queries and exact values, never the whole blob.",
  "version": "1.9.1",
  "websiteUrl": "https://jsonloupe.dev/",
  "repository": {
    "url": "https://github.com/priyanshuN/jsonloupe",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "jsonloupe",
      "version": "1.9.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
