{
  "name": "jsonloupe",
  "version": "1.2.0",
  "description": "A loupe for large JSON — lossless, local-first viewer, differ, and query tool. Int64-exact, worker-powered, zstd-aware.",
  "license": "MIT",
  "author": "Priyanshu Nandan",
  "homepage": "https://jsonloupe.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/priyanshuN/jsonloupe.git"
  },
  "keywords": [
    "json",
    "viewer",
    "diff",
    "jsonpath",
    "mcp",
    "mcp-server",
    "lossless",
    "int64",
    "zstd",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "jsonloupe": "bin/jsonloupe.mjs",
    "jsonloupe-mcp": "bin/jsonloupe-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "dist-mcp",
    "dist-cli",
    "docs/agent-choice-eval.md",
    "ARCHITECTURE.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "DESIGN-AUDIT.md",
    "GOVERNANCE.md",
    "RELEASING.md",
    "REPRODUCIBLE-BUILD.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SECURITY-ASSURANCE.md",
    "SECURITY-HEADERS.md",
    "SPEC.md",
    "SPEC-converter.md",
    "THIRD_PARTY_LICENSES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.13.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite --port 5199",
    "lint:contract": "node scripts/lint-contract.mjs",
    "lint:headers": "node scripts/check-source-headers.mjs",
    "lint:security": "biome lint",
    "build": "tsc --noEmit && vite build && npm run build:mcp && npm run build:cli",
    "build:mcp": "tsc -p tsconfig.mcp.json --noEmit && node scripts/build-mcp.mjs",
    "build:cli": "tsc -p tsconfig.cli.json --noEmit && node scripts/build-cli.mjs",
    "check:reproducible-build": "node scripts/check-repeatable-build.mjs",
    "check:repeatable-build": "npm run check:reproducible-build",
    "check:site-headers": "node scripts/check-site-headers.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "eval:agent": "node scripts/agent-choice-eval.mjs",
    "preview": "vite preview --port 5199",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.thresholds.statements=90 --coverage.thresholds.branches=80",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "codemirror": "^6.0.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.2",
    "jsonrepair": "^3.15.0",
    "lossless-json": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
