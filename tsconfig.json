{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // src/mcp is Node-only (worker_threads, fs). It is typechecked by
  // tsconfig.mcp.json, which adds the node types this browser config must not
  // carry — nothing shipped to a page should see them.
  "exclude": ["src/mcp"]
}
